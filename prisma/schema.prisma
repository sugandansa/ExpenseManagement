generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(120)
  email          String?  @db.VarChar(160)
  phone          String   @unique @db.VarChar(15)
  role           String   @default("employee") @db.VarChar(32)
  /** Job role FK (role_caps). Nullable so existing rows stay unchanged. */
  roleCapId      Int?     @map("role_cap_id")
  department     String?  @db.VarChar(120)
  monthlyBudget  Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  passwordHash   String?  @map("password_hash") @db.VarChar(120)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roleCap        RoleCap? @relation(fields: [roleCapId], references: [id])
  otpRequests    OtpRequest[]
  sessions       AuthSession[]
  receipts       Receipt[]
  claims         ExpenseClaim[]
  claimEvents    ClaimEvent[]
  wallet         Wallet?
  settlements    WalletSettlement[]
  ledgerEntries  WalletLedger[]

  @@index([roleCapId])
  @@map("users")
}

model OtpRequest {
  id          Int       @id @default(autoincrement())
  requestId   String    @unique @map("request_id") @db.VarChar(40)
  userId      Int?      @map("user_id")
  phone       String    @db.VarChar(15)
  codeHash    String    @map("code_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  resendAfter DateTime  @map("resend_after")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, createdAt])
  @@map("otp_requests")
}

model AuthSession {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  deviceId  String    @map("device_id") @db.VarChar(120)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deviceId])
  @@map("auth_sessions")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(80)
  iconCategory String   @map("icon_category") @db.VarChar(80)
  monthlyCap   Decimal  @default(0) @map("monthly_cap") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subCategories SubCategory[]
  claims        ExpenseClaim[]

  @@map("categories")
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  name       String   @db.VarChar(80)
  monthlyCap Decimal  @default(0) @map("monthly_cap") @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  category Category       @relation(fields: [categoryId], references: [id])
  claims   ExpenseClaim[]

  @@index([categoryId])
  @@map("sub_categories")
}

model Receipt {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  userId    Int      @map("user_id")
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(80)
  sizeBytes Int      @map("size_bytes")
  fileUrl   String   @map("file_url") @db.VarChar(500)
  ocrStatus String   @default("queued") @map("ocr_status") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  user  User          @relation(fields: [userId], references: [id])
  claim ExpenseClaim?

  @@index([userId])
  @@map("receipts")
}

model ExpenseClaim {
  id               Int       @id @default(autoincrement())
  code             String    @unique @db.VarChar(40)
  userId           Int       @map("user_id")
  receiptId        Int       @unique @map("receipt_id")
  amount           Decimal   @db.Decimal(12, 2)
  categoryId       Int?      @map("category_id")
  subCategoryId    Int?      @map("sub_category_id")
  note             String?   @db.VarChar(500)
  otherCategory    String?   @map("other_category") @db.VarChar(120)
  submissionDate   DateTime  @map("submission_date")
  status           String    @default("pending") @db.VarChar(32)
  approvalStatus   String    @default("pending") @map("approval_status") @db.VarChar(32)
  paymentStatus    String    @default("pending") @map("payment_status") @db.VarChar(32)
  rejectionReason  String?   @map("rejection_reason") @db.VarChar(500)
  isOverBudget     Boolean   @default(false) @map("is_over_budget")
  overBudgetAmount Decimal   @default(0) @map("over_budget_amount") @db.Decimal(12, 2)
  /** Amount already settled/paid out against this claim (supports partial payments). */
  paidAmount       Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  approvedAt       DateTime? @map("approved_at")
  approvalComment  String?   @map("approval_comment") @db.VarChar(500)
  settlementId     Int?      @map("settlement_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id])
  receipt       Receipt            @relation(fields: [receiptId], references: [id])
  category      Category?          @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?       @relation(fields: [subCategoryId], references: [id])
  events        ClaimEvent[]
  settlement    WalletSettlement?  @relation(fields: [settlementId], references: [id])
  ledgerEntries WalletLedger[]

  @@index([userId, status, createdAt])
  @@index([userId, submissionDate])
  @@index([settlementId])
  @@map("expense_claims")
}

model ClaimEvent {
  id        Int      @id @default(autoincrement())
  claimId   Int      @map("claim_id")
  actorId   Int?     @map("actor_id")
  status    String   @db.VarChar(32)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  claim ExpenseClaim @relation(fields: [claimId], references: [id])
  actor User?        @relation(fields: [actorId], references: [id])

  @@index([claimId, createdAt])
  @@map("claim_events")
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model WalletSettlement {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  userId      Int      @map("user_id")
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String   @map("payment_mode") @db.VarChar(40)
  reference   String?  @db.VarChar(120)
  status      String   @default("settled") @db.VarChar(32)
  settledAt   DateTime @default(now()) @map("settled_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  claims        ExpenseClaim[]
  ledgerEntries WalletLedger[]

  @@index([userId, createdAt])
  @@map("wallet_settlements")
}

model RoleCap {
  id          Int      @id @default(autoincrement())
  role        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(255)
  monthlyCap  Decimal  @map("monthly_cap") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("role_caps")
}

model WalletLedger {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  type         String   @db.VarChar(16)
  amount       Decimal  @db.Decimal(12, 2)
  claimId      Int?     @map("claim_id")
  settlementId Int?     @map("settlement_id")
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  user       User              @relation(fields: [userId], references: [id])
  claim      ExpenseClaim?     @relation(fields: [claimId], references: [id])
  settlement WalletSettlement? @relation(fields: [settlementId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_ledger")
}

model AppSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(80)
  settingValue String   @map("setting_value") @db.VarChar(500)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
