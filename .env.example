NODE_ENV=development
PORT=5020
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_NAME=ExpenseManagement
DB_USERNAME=schoollift
DB_PASSWORD=

DATABASE_URL="mysql://schoollift:PASSWORD@127.0.0.1:3306/ExpenseManagement"

JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=3600
OTP_PEPPER=change-this-otp-pepper
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

VAPID_PUBLIC_KEY=

# Phones that always receive OTP_TEST_CODE instead of a random code (no SMS).
# Leave OTP_TEST_CODE empty to disable test numbers entirely.
OTP_TEST_CODE=
OTP_TEST_PHONES=

# MSG91 SMS (OTP Flow API). AUTH_KEY=test → mock send (logs OTP, does not call MSG91).
MSG91_AUTH_KEY=test
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=WHTOCN
# Variable name inside MSG91 flow / DLT (##num## → num). Override if template uses ##OTP##.
MSG91_OTP_VAR=num

UPLOAD_DIR=./uploads
# After DNS for smweaves.com points to this server, use:
PUBLIC_BASE_URL=https://smweaves.com
# Legacy SchoolLift path (until cutover):
# PUBLIC_BASE_URL=https://api.schoollift.in/expense-management
